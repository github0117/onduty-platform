APP_ENV=development
APP_AUTH_MODE=dev
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
OIDC_CUSTOMER_REF_CLAIM=
OIDC_BUSINESS_UNITS_CLAIM=business_units
VITE_OIDC_BUSINESS_UNIT_ID=bu_demo
DATABASE_URL=postgresql+psycopg://ticket_agent:ticket_agent@localhost:5432/ticket_agent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
MAX_REQUEST_BYTES=33554432
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_MINUTE=120
TASK_MODE=celery
DEMO_RESET_ENABLED=true
DEMO_RESET_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:5173"]
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.80
CUSTOMER_SERVICE_AUTO_REPLY_ENABLED=true
CUSTOMER_SERVICE_AUTO_REPLY_MIN_CONFIDENCE=0.85
CUSTOMER_SERVICE_AUTO_REPLY_MAX_CHARACTERS=1200
MCP_REFUND_SUPERVISOR_LIMIT=500
MCP_REFUND_ABSOLUTE_LIMIT=5000
MCP_RECONCILIATION_MAX_ATTEMPTS=3
MCP_RECONCILIATION_BATCH_SIZE=20
MODEL_PROVIDER=local
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_RETRIES=2
MODEL_MAX_OUTPUT_TOKENS=800
MODEL_FALLBACK_TO_LOCAL=true
MODEL_DATA_REDACTION_ENABLED=true
MODEL_INPUT_COST_PER_1K_TOKENS=0
MODEL_OUTPUT_COST_PER_1K_TOKENS=0
# 千问 DashScope OpenAI 兼容接口（密钥只写入本机 .env，不提交）
# MODEL_PROVIDER=openai_compatible
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
# MODEL_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBEDDING_DIMENSIONS=256
EMBEDDING_FALLBACK_TO_LOCAL=true
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_SEARCH_TOP_K=5
KNOWLEDGE_MIN_SCORE=0.15
KNOWLEDGE_MAX_FILE_BYTES=20971520
KNOWLEDGE_RERANKER=hybrid
KNOWLEDGE_VECTOR_WEIGHT=0.6
KNOWLEDGE_LEXICAL_WEIGHT=0.4
KNOWLEDGE_CANDIDATE_MULTIPLIER=5
KNOWLEDGE_RERANK_PROVIDER=local
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL_NAME=
RERANK_TIMEOUT_SECONDS=20
RERANK_FALLBACK_TO_LOCAL=true
# local = lexical overlap check; external = separate judge model; none disables
# claim verification and therefore blocks automatic replies.
CLAIM_VERIFIER_PROVIDER=local
CLAIM_VERIFIER_BASE_URL=
CLAIM_VERIFIER_API_KEY=
CLAIM_VERIFIER_MODEL_NAME=
CLAIM_VERIFIER_TIMEOUT_SECONDS=20
CLAIM_VERIFIER_ENFORCE=false
CLAIM_VERIFIER_FALLBACK_TO_LOCAL=true
TICKET_INTEGRATION_PROVIDER=local
TICKET_API_BASE_URL=
TICKET_API_KEY=
TICKET_API_TIMEOUT_SECONDS=20
TICKET_SYNC_MAX_ATTEMPTS=5
ECOMMERCE_CHANNEL_PROVIDER=local
ECOMMERCE_CHANNEL_BASE_URL=
ECOMMERCE_CHANNEL_API_KEY=
ECOMMERCE_CHANNEL_TIMEOUT_SECONDS=20
LOGISTICS_QUERY_PROVIDER=none
LOGISTICS_QUERY_BASE_URL=
LOGISTICS_QUERY_API_KEY=
LOGISTICS_QUERY_TIMEOUT_SECONDS=20
PINDUODUO_API_BASE_URL=https://gw-api.pinduoduo.com/api/router
PINDUODUO_CLIENT_ID=
PINDUODUO_CLIENT_SECRET=
PINDUODUO_ACCESS_TOKEN=
PINDUODUO_API_TIMEOUT_SECONDS=20
# 电商 Listing 文案模型：可配置千问 DashScope OpenAI 兼容接口
ECOMMERCE_CONTENT_PROVIDER=local
ECOMMERCE_CONTENT_BASE_URL=
ECOMMERCE_CONTENT_API_KEY=
ECOMMERCE_CONTENT_MODEL_NAME=
ECOMMERCE_CONTENT_TIMEOUT_SECONDS=60
ECOMMERCE_CONTENT_FALLBACK_TO_LOCAL=true
ECOMMERCE_IMAGE_PROVIDER=dashscope
ECOMMERCE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
ECOMMERCE_IMAGE_API_KEY=
ECOMMERCE_IMAGE_MODEL_NAME=z-image-turbo
ECOMMERCE_IMAGE_TIMEOUT_SECONDS=60
ECOMMERCE_IMAGE_FALLBACK_TO_LOCAL=true
ECOMMERCE_IMAGE_COST_PER_IMAGE=0
ECOMMERCE_VISUAL_AUDIT_PROVIDER=dashscope_ocr
ECOMMERCE_VISUAL_AUDIT_MODEL_NAME=qwen-vl-ocr
ECOMMERCE_VISUAL_AUDIT_TIMEOUT_SECONDS=60
ECOMMERCE_TTS_PROVIDER=dashscope_qwen
ECOMMERCE_TTS_MODEL_NAME=qwen3-tts-flash
ECOMMERCE_TTS_VOICE=Cherry
ECOMMERCE_TTS_TIMEOUT_SECONDS=90
ECOMMERCE_SUBTITLE_BURN_IN=true
ECOMMERCE_SUBTITLE_FONT_PATH=/app/assets/fonts/NotoSansCJKsc-Regular.otf
ECOMMERCE_FFMPEG_PATH=ffmpeg
SYNC_ALERT_FAILURE_RATE=0.1
SYNC_ALERT_RETRYING_COUNT=20
METRICS_SCRAPE_TOKEN=
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_ROOT=./data/objects
# 接入 S3 兼容对象存储时，将 OBJECT_STORAGE_PROVIDER 改为 s3 并填写以下变量。
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1

